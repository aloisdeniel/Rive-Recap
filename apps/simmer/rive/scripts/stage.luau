--!strict
-- Simmer responsive stage: the one place the layout maths lives.
--
-- Orientation is a pure width breakpoint: landscape when the artboard is at
-- least `layoutBreakpoint` wide (768 by default), portrait otherwise, whatever
-- the height. `compute` turns the real artboard size into a handful of
-- orientation-resolved slot values; the director writes them into UserRecap
-- and the scenes' bindings (formulas generated by tools/stage.py) place each
-- scene's copy group and art group from them. `frame` mirrors those formulas
-- for the scripts that need a scene's art transform (the pot motif's carry,
-- the steam origin, the lettering resolution).
--
-- Portrait (width < breakpoint)
--   One column: header, the copy block (hero number, unit, headline,
--   support) top-left, the scene's art below it filling the rest, the
--   controls along the bottom. On short canvases (667 x 375, 740 x 360) the
--   art moves beside the copy when that lets it print larger ("side" mode).
--   Copy scales with the width, never below 0.72 (support text >= 13 pt).
-- Landscape (width >= breakpoint)
--   A copy column (36% of the width, 300-540 pt) on one side and the art on
--   the other, sides alternating with the master's left/right copy rhythm.
--   Ultra-wide canvases keep the composition inside 1760 pt, centred.
--
-- At 390 x 844 every value equals the master's, so the frames are identity.

local boxes = require('scripts/stageBoxes')

export type Slots = {
    W: number,
    H: number,
    landscape: boolean,
    m: number,          -- side margin for chrome and copy
    top: number,        -- content top (below the progress bar)
    bottom: number,     -- art bottom (above the controls)
    controlsY: number,  -- controls row centre
    continueW: number,  -- Continue button width
    cs: number,         -- copy scale
    cw: number,         -- copy text width, in copy (unscaled) points
    avail: number,      -- copy is centred in this height when > 0
    copyXa: number,     -- copy column left, side a / side b
    copyXb: number,
    artX0a: number,     -- art region, side a / side b
    artX1a: number,
    artX0b: number,
    artX1b: number,
    stack: number,      -- 1: the art region starts below the copy (portrait)
    side: number,       -- 1: short portrait, the art sits beside the copy
}

local M = {}

local METRIC_COPY_H = 288 -- the tallest copy band (metric scenes), drives the shared copy scale
local METRIC_ART_H = 390

local function clamp(x: number, lo: number, hi: number): number
    return math.max(lo, math.min(hi, x))
end

function M.isLandscape(W: number, breakpoint: number): boolean
    return W >= breakpoint
end

function M.compute(W: number, H: number, breakpoint: number): Slots
    local s: Slots = {
        W = W, H = H, landscape = false, m = 24, top = 92, bottom = 770, controlsY = 792, continueW = 214,
        cs = 1, cw = 342, avail = 0, copyXa = 24, copyXb = 24,
        artX0a = 0, artX1a = W, artX0b = 0, artX1b = W, stack = 1, side = 0,
    }
    if not M.isLandscape(W, breakpoint) then
        local short = clamp((640 - H) / 240, 0, 1) -- compresses the header and controls on short canvases
        local m = clamp(W * 24 / 390, 16, 40)
        local top = 92 - 26 * short
        local cy = H - 52 + 14 * short
        -- the art box ends just above the controls (770 in the master); a little more air when small
        local bottom = cy - 22 - 8 * clamp((844 - H) / 300, 0, 1)
        s.m, s.top, s.controlsY, s.bottom = m, top, cy, bottom
        s.continueW = math.min(W - 2 * m - 128, 300)
        local cs0 = clamp(math.min((W - 2 * m) / 342, H / 844 * 1.15), 0.72, 1.5)
        -- below: the art fills the full width under the copy
        local topB = top + cs0 * METRIC_COPY_H
        local sB = math.min(W / 390, (bottom - topB) / METRIC_ART_H)
        -- side: copy column on the left at its master width, art beside it
        local csS = clamp(math.min(cs0, (bottom - top) / METRIC_COPY_H), 0.72, 1.5)
        local x0 = m + csS * 342 + m
        local x1 = W - m
        local sS = math.min((x1 - x0) / 390, (bottom - top) / METRIC_ART_H)
        s.copyXa, s.copyXb = m, m
        if sS > sB then
            s.cs, s.cw, s.avail, s.stack, s.side = csS, 342, bottom - top, 0, 1
            s.artX0a, s.artX1a, s.artX0b, s.artX1b = x0, x1, x0, x1
        else
            s.cs, s.cw, s.avail, s.stack = cs0, (W - 2 * m) / cs0, 0, 1
            s.artX0a, s.artX1a, s.artX0b, s.artX1b = 0, W, 0, W
        end
    else
        s.landscape = true
        local short = clamp((760 - H) / 200, 0, 1)
        local m = clamp(W * 0.04, 28, 72)
        local inset = math.max(m, (W - 1760) / 2) -- ultra-wide: keep the composition together
        -- tall landscape canvases (768 x 1024, 820 x 1180): a narrower column with larger type,
        -- and the art bleeds to the outer edge, so the composition fills more of the height
        local tall = clamp((H / W - 0.75) / 0.5, 0, 1)
        local top = 100 - 16 * short
        local cy = H - 26 - clamp(H * 0.035, 16, 36)
        local bottom = cy - 26 - 18
        local col = clamp(W * (0.36 - 0.04 * tall), 280, 540)
        local avail = bottom - top
        local cs = clamp(math.min(col / 342 * (1 + 0.35 * tall), avail / METRIC_COPY_H), 0.72, 1.6)
        s.m, s.top, s.controlsY, s.bottom = m, top, cy, bottom
        s.continueW = clamp(W * 0.22, 240, 340)
        s.cs, s.cw, s.avail, s.stack = cs, col / cs, avail, 0
        s.copyXa = inset
        s.copyXb = W - inset - col
        local bleed = inset * (1 - tall) -- the art's outer edge: the margin, or the canvas edge when tall
        s.artX0a, s.artX1a = inset + col + m, W - bleed
        s.artX0b, s.artX1b = bleed, W - inset - col - m
    end
    return s
end

-- (tx, ty, scale) for a box: where the box's authored origin lands and how much it is scaled.
-- Mirrors tools/stage.py `art_frame`.
function M.frame(s: Slots, key: string): (number, number, number)
    local b = boxes[key]
    if b == nil then
        return 0, 0, 1
    end
    local x0 = if b.side == 'a' then s.artX0a else s.artX0b
    local x1 = if b.side == 'a' then s.artX1a else s.artX1b
    local stack = s.stack
    if b.reflow == 1 and s.side == 1 then
        x0, x1, stack = 0, s.W, stack + 1
    end
    local top = s.top + stack * s.cs * b.copyH
    local sc = math.min((x1 - x0) / b.bw, (s.bottom - top) / b.bh)
    local tx = (x0 + x1) * 0.5 - sc * (b.bx + b.bw / 2)
    local ty = top + ((s.bottom - top) - sc * b.bh) * 0.5 - sc * b.by
    return tx, ty, sc
end

-- The tall card's pot sits at (294, 278) in scene 10; the wide card's at (107, 367).
local POT_TALL_X, POT_TALL_Y = 294, 278
local POT_WIDE_X, POT_WIDE_Y = 107, 367

-- The frame of canonical scene k as the pot motif sees it. Scene 10 follows whichever share
-- card is showing, shifted so the motif's fly-in lands in that card's pot slot.
function M.sceneFrame(s: Slots, k: number): (number, number, number)
    if k == 10 then
        local tx, ty, sc = M.frame(s, '10')
        local wx, wy, ws = M.frame(s, '10wide')
        if ws * 18 > sc * 15 * 1.05 then
            return wx + ws * (POT_WIDE_X - POT_TALL_X), wy + ws * (POT_WIDE_Y - POT_TALL_Y), ws
        end
        return tx, ty, sc
    end
    return M.frame(s, tostring(math.clamp(math.floor(k), 1, 9)))
end

-- Slots from the values the director wrote into UserRecap (for scripts that only see the model).
function M.fromModel(vm: ViewModel?): Slots?
    if vm == nil then
        return nil
    end
    local function n(name: string, fallback: number): number
        local p = vm:getNumber(name)
        return if p ~= nil then p.value else fallback
    end
    local W, H = n('stageWidth', 390), n('stageHeight', 844)
    return M.compute(W, H, n('layoutBreakpoint', 768))
end

return M
